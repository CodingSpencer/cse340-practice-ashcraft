<%- include('../partials/header', { 
    heading: `${faculty.name} - Faculty Profile`, 
    cssFile: '/css/styles.css' 
}) %>

<main class="container">
    <nav class="navigation">
        <p><a href="/faculty">&larr; Back to Faculty Directory</a></p>
    </nav>

    <article class="profile-card">
        <header class="course-header">
            <h1><%= faculty.name %></h1>
            <div class="faculty-title"><strong><%= faculty.title %></strong></div>
            <div class="faculty-dept"><%= faculty.department %> Area</div>
        </header>

        <div class="sections">
            <h2>Contact Information</h2>
            <div class="section-list">
                <div class="section-card">
                    <strong>Email:</strong> 
                    <a href="mailto:<%= faculty.email %>"><%= faculty.email %></a>
                </div>
                <div class="section-card">
                    <strong>Office Location:</strong> 
                    <span><%= faculty.office %></span>
                </div>
                <div class="section-card">
                    <strong>Phone Number:</strong> 
                    <span><%= faculty.phone %></span>
                </div>
            </div>
        </div>
        
        <!-- Keep biography display if the table schema holds bio info -->
        <% if (faculty.bio) { %>
            <div class="course-description" style="margin-top: 20px;">
                <h2>Biography</h2>
                <p><%= faculty.bio %></p>
            </div>
        <% } %>
    </article>
</main>

<%- include('../partials/footer') %>