<%- include('../partials/header', { 
    heading: "Faculty Directory", 
    cssFile: '/css/styles.css' 
}) %>

<main class="container">
    <%- include('../partials/flash-messages') %>
    <nav class="navigation">
        <p><a href="/">&larr; Back to Home</a></p>
    </nav>

    <div class="course-header">
        <% if (locals.greeting) { %>
            <p class="course-meta"><%= greeting %></p>
        <% } %>
        <h1>Faculty Directory</h1>
        <p class="course-description">Meet our esteemed faculty members and explore their academic contributions.</p>
    </div>

    <div class="sections">
        <div class="sections-header">
            <h2>Our Faculty</h2>
            <!-- Optional enhancement: if you want to support step 7's sorting feature visually -->
            <div class="sort-options">
                <span>Sort by: </span>
                <a href="/faculty?sort=name" class="<%= currentSort === 'name' ? 'active' : '' %>">Name</a>
                <a href="/faculty?sort=department" class="<%= currentSort === 'department' ? 'active' : '' %>">Department</a>
                <a href="/faculty?sort=title" class="<%= currentSort === 'title' ? 'active' : '' %>">Title</a>
            </div>
        </div>

        <div class="section-list">
            <% if (faculty && faculty.length > 0) { %>
                <% faculty.forEach(member => { %>
                    <div class="section-card">
                        <div class="section-time">
                            <strong><a href="/faculty/<%= member.slug %>"><%= member.name %></a></strong>
                        </div>
                        <img class="faculty-list-img" src="/images/faculty/<%= member.slug %>.jpg" alt="Member Image">
                        <div class="section-title">Role: <%= member.title %></div>
                        <div class="section-room">Department: <%= member.department %></div>
                    </div>
                <% }) %>
            <% } else { %>
                <p>No faculty members found.</p>
            <% } %>
        </div>
    </div>
</main>

<%- include('../partials/footer') %>