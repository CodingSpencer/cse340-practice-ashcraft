<%- include('../partials/header', { heading: "Course Catalog", cssFile: "/css/styles.css" }) %>
<main>
    <p>Browse our available courses and click on any course to see detailed information including available sections and instructors.</p>

    <div class="course-list">
        <% if (courses && courses.length > 0) { %>
            <% courses.forEach(course => { %>
                <div class="course-card">
                    <h3><a href="/catalog/<%= course.slug %>"><%= course.name %></a></h3>
                    <p class="course-id"><%= course.courseCode %> • <%= course.creditHours %> credits</p>
                    <p class="course-description"><%= course.description %></p>
                </div>
            <% }); %>
        <% } else { %>
            <p>No courses found in the catalog.</p>
        <% } %>
    </div>
</main>
<%- include('../partials/footer') %>