<%- include('../partials/header', { 
    heading: `${course.courseCode}: ${course.name}`, 
    cssFile: '/css/styles.css',
    nodeEnv: nodeEnv 
}) %>

<main>
    <%- include('../partials/flash-messages') %>
    <div class="course-header">
        <h1><%= course.name %></h1>
        <p class="course-meta"><%= course.courseCode %> • <%= course.creditHours %> credits</p>
        <p class="course-description"><%= course.description %></p>
    </div>

    <div class="sections">
        <div class="sections-header">
            <h2>Available Sections</h2>
            <div class="sort-options">
                <span>Sort by: </span>
                <a href="/catalog/<%= course.slug %>?sort=time" class="<%= currentSort === 'time' ? 'active' : '' %>">Time</a>
                
                <a href="/catalog/<%= course.slug %>?sort=professor" class="<%= currentSort === 'professor' ? 'active' : '' %>">Professor</a>
                
                <a href="/catalog/<%= course.slug %>?sort=room" class="<%= currentSort === 'room' ? 'active' : '' %>">Room</a>
            </div>
        </div>

        <div class="section-list">
            <% if (sections && sections.length > 0) { %>
                <% sections.forEach(section => { %>
                    <div class="section-card">
                        <div class="section-time"><%= section.time %></div>
                        <div class="section-room">Room: <%= section.room %></div>
                        <div class="section-professor">
                            Instructor: <a href="/faculty/<%= section.professorSlug %>"><%= section.professor %></a>
                        </div>
                    </div>
                <% }); %>
            <% } else { %>
                <div class="no-sections">
                    <p>No sections available for this course.</p>
                </div>
            <% } %>
        </div>
    </div>

    <div class="navigation">
        <p><a href="/catalog">&larr; Back to Course Catalog</a></p>
    </div>
</main>
<%- include('../partials/footer') %>