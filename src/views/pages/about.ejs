<%- include('../partials/header', { 
    heading: "About Me", 
    cssFile: '/css/styles.css' 
}) %>

<main class="container">
    <div class="course-header">
        <h1><%= title %></h1>
        <p class="course-meta">Student Profile</p>
    </div>

    <div class="sections">
        <div class="section-list" style="display: grid; grid-template-columns: 1fr 200px; gap: 20px; align-items: start;">
            
            <!-- Student Information details -->
            <div class="student-info">
                <div class="section-card" style="margin-bottom: 15px;">
                    <p><strong>Name:</strong> <%= student.name %></p>
                    <p><strong>Age:</strong> <%= student.age %> years old</p>
                    <p><strong>Major:</strong> <%= student.major %></p>
                </div>

                <div class="section-card" style="margin-bottom: 15px;">
                    <h3>Description</h3>
                    <p class="course-description" style="padding: 0;"><%= student.desc %></p>
                </div>

                <div class="section-card">
                    <h3>Hobbies</h3>
                    <ul style="padding-left: 20px; margin-top: 10px;">
                        <% student.hobbies.forEach(hobby => { %>
                            <li style="margin-bottom: 5px;"><%= hobby %></li>
                        <% }) %>
                    </ul>
                </div>
            </div>

            <!-- Profile Image Side-Block -->
            <div class="profile-image-wrapper">
                <img src="/images/Spencer-Headshot.jpg" alt="Spencer Headshot" style="width: 100%; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.1);">
            </div>

        </div>
    </div>

    <div class="navigation" style="margin-top: 30px;">
        <p><a href="/">&larr; Back to Home</a></p>
    </div>
</main>

<%- include('../partials/footer') %>