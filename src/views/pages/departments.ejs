<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/main.css">
</head>
<body class="<%= bodyClass %>">
    <%- include('../partials/header', { heading: "Academic Departments" }) %>

    <main class="departments-container">
        <header>
            <h1>Academic Departments</h1>
            <p>Browse our current course offerings organized by academic focus.</p>
        </header>

        <hr>

        <% if (Object.keys(departments).length === 0) { %>
            <p>No departments or courses found at this time.</p>
        <% } else { %>
            <!-- Loop through each department name (the keys of our object) -->
            <% for (const deptName in departments) { %>
                <section class="dept-section">
                    <h2 class="dept-title">📁 <%= deptName %></h2>
                    
                    <ul class="course-list">
                        <!-- Loop through the array of courses belonging to this department -->
                        <% departments[deptName].forEach(course => { %>
                            <li class="course-item">
                                <a class="course-link" href="/catalog/<%= course.id %>">
                                    <%= course.id.toUpperCase() %>: <%= course.name %>
                                </a>
                                <span class="badge"><%= course.credits %> Credits</span>
                            </li>
                        <% }) %>
                    </ul>
                </section>
            <% } %>
        <% } %>
    </main>
    <%- include('../partials/footer') %>
</body>
</html>